{
    "name": "Neo4j",
    "version": "0.2.16",
    "author": "hackolade",
    "engines": {
        "hackolade": "6.8.5",
        "hackoladePlugin": "1.0.0"
    },
    "contributes": {
        "target": {
            "applicationTarget": "NEO4J",
            "title": "Neo4j",
            "versions": [
                "3.x",
                "4.0-4.2",
                "4.3",
                "4.4",
                "5.x"
            ]
        },
        "features": {
            "jaySchemaHasRequiredPatternField": false,
            "nestedCollections": {
                "isVirtual": true,
                "hasMultipleParents": true
            },
            "graphDB": true,
            "relationships": {
                "connectOnEntityLevel": true,
                "hasData": true
            },
            "enableForwardEngineering": {
                "jsonDocument": true,
                "jsonSchema": true,
                "excel": true,
                "plugin": true
            },
            "enableReverseEngineering": {
                "jsonDocument": true,
                "jsonSchema": true,
                "ddl": true,
                "xsd": true,
                "excel": true,
                "plugin": true
            },
            "FEScriptCommentsSupported": true
        }
    },
    "description": "Hackolade plugin for Neo4j",
    "disabled": false,
    "dependencies": {
        "@webpod/ip": "0.6.1",
        "async": "3.2.6",
        "lodash": "4.18.1",
        "neo4j-driver": "4.4.11"
    },
    "simple-git-hooks": {
        "pre-commit": "npm run package && npx lint-staged --config lint-staged.config.js",
        "pre-push": "npm run lint"
    },
    "scripts": {
        "lint": "oxlint . || true",
        "package": "node esbuild.package.js",
        "install": "npx patch-package",
        "patch-neo4j-driver": "npx patch-package neo4j-driver",
        "lint:check": "oxlint --type-aware --type-check . || true",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@hackolade/hck-esbuild-plugins-pack": "0.0.1",
        "@ianvs/prettier-plugin-sort-imports": "4.7.1",
        "esbuild": "0.28.1",
        "esbuild-node-externals": "1.23.1",
        "esbuild-plugin-clean": "1.0.1",
        "esbuild-plugin-copy": "2.1.1",
        "lint-staged": "17.0.7",
        "oxlint": "1.70.0",
        "oxlint-tsgolint": "0.23.0",
        "patch-package": "8.0.1",
        "prettier": "3.8.4",
        "simple-git-hooks": "2.13.1"
    },
    "overrides": {
        "minimatch": "10.2.4",
        "brace-expansion": "5.0.8"
    }
}
